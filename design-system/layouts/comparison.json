{
  "id": "comparison",
  "name": "Comparison",
  "type": "comparison",
  "description": "Side-by-side comparison layout for before/after or A/B contrasts.",
  "zones": ["slide-header", "slide-body", "slide-footer"],
  "footer": { "visible": true },
  "html": "<div class=\"slide-header\"><h1>{{title}}</h1>{{#subtitle}}<div class=\"slide-subtitle\">{{subtitle}}</div>{{/subtitle}}</div><div class=\"slide-body\"><div class=\"comparison-grid\"><div class=\"panel panel-left\">{{#leftCard}}<div class=\"panel-tag\">{{tag}}</div><h2>{{title}}</h2>{{#subtitle}}<p class=\"panel-subtitle\">{{subtitle}}</p>{{/subtitle}}{{#points}}<div class=\"point\"><span class=\"point-dot\"></span><span class=\"point-text\">{{.}}</span></div>{{/points}}{{/leftCard}}</div><div class=\"versus\">VS</div><div class=\"panel panel-right\">{{#rightCard}}<div class=\"panel-tag\">{{tag}}</div><h2>{{title}}</h2>{{#subtitle}}<p class=\"panel-subtitle\">{{subtitle}}</p>{{/subtitle}}{{#points}}<div class=\"point\"><span class=\"point-dot\"></span><span class=\"point-text\">{{.}}</span></div>{{/points}}{{/rightCard}}</div></div>{{#summary}}<div class=\"summary\">{{summary}}</div>{{/summary}}</div><div class=\"slide-footer\">{{page}} / {{total}}</div>",
  "css": {
    ".slide.comparison": { "display": "flex", "flex-direction": "column" },
    ".slide.comparison .slide-header": { "padding-bottom": "18px" },
    ".slide.comparison .slide-header h1": { "font-size": "var(--slide-title-size)", "color": "var(--title)", "border-bottom": "3px solid var(--accent)", "margin": "0", "width": "100%", "letter-spacing": "-0.03em" },
    ".slide.comparison .slide-subtitle": { "padding-top": "16px", "font-size": "var(--slide-subtitle-size)", "color": "var(--muted)" },
    ".slide.comparison .slide-body": { "flex": "1", "display": "flex", "flex-direction": "column", "gap": "22px", "padding": "18px 0 20px" },
    ".slide.comparison .comparison-grid": { "flex": "1", "display": "grid", "grid-template-columns": "minmax(0, 1fr) 80px minmax(0, 1fr)", "gap": "18px", "align-items": "stretch" },
    ".slide.comparison .panel": { "position": "relative", "overflow": "hidden", "background": "linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.015)), var(--surface)", "padding": "32px 30px 28px", "border-radius": "20px", "display": "flex", "flex-direction": "column", "justify-content": "center", "gap": "16px", "min-width": "0", "border": "1px solid rgba(88, 166, 255, 0.10)", "box-shadow": "0 16px 34px rgba(0, 0, 0, 0.20)" },
    ".slide.comparison .panel::before": { "content": "\"\"", "position": "absolute", "left": "0", "right": "0", "top": "0", "height": "4px", "background": "linear-gradient(90deg, rgba(88, 166, 255, 0.9), rgba(121, 192, 255, 0.25))" },
    ".slide.comparison .panel-right::before": { "background": "linear-gradient(90deg, rgba(121, 192, 255, 0.3), rgba(88, 166, 255, 0.9))" },
    ".slide.comparison .panel-tag": { "display": "inline-flex", "align-self": "flex-start", "padding": "6px 10px", "border-radius": "999px", "background": "rgba(88, 166, 255, 0.12)", "font-size": "14px", "font-weight": "bold", "letter-spacing": "0.14em", "color": "var(--accent)" },
    ".slide.comparison .panel h2": { "font-size": "var(--slide-heading-size)", "color": "var(--title)", "line-height": "1.12", "letter-spacing": "-0.02em" },
    ".slide.comparison .panel-subtitle": { "font-size": "var(--slide-subtitle-size)", "line-height": "1.45", "color": "var(--muted)" },
    ".slide.comparison .point": { "display": "flex", "align-items": "flex-start", "gap": "12px", "font-size": "var(--slide-body-size)", "line-height": "1.45", "color": "var(--text)" },
    ".slide.comparison .point-dot": { "width": "12px", "height": "12px", "border-radius": "999px", "background": "var(--accent)", "margin-top": "10px", "flex-shrink": "0" },
    ".slide.comparison .point-text": { "min-width": "0" },
    ".slide.comparison .versus": { "align-self": "center", "justify-self": "center", "width": "72px", "height": "72px", "border-radius": "999px", "display": "flex", "align-items": "center", "justify-content": "center", "font-size": "26px", "font-weight": "bold", "color": "var(--accent)", "letter-spacing": "0.08em", "background": "rgba(88, 166, 255, 0.12)", "border": "1px solid rgba(88, 166, 255, 0.35)", "box-shadow": "0 10px 24px rgba(0, 0, 0, 0.18)" },
    ".slide.comparison .summary": { "padding": "18px 24px", "border-left": "4px solid var(--accent)", "background": "rgba(255, 255, 255, 0.03)", "border-radius": "14px", "font-size": "var(--slide-subtitle-size)", "line-height": "1.5", "color": "var(--muted)", "border": "1px solid rgba(88, 166, 255, 0.12)" },
    ".slide.comparison .slide-footer": { "padding-top": "20px", "font-size": "var(--slide-footer-size)", "color": "var(--muted)", "text-align": "right" }
  }
}
