{
  "id": "content-row",
  "name": "横向正文",
  "type": "content",
  "description": "横向单行卡片",
  "zones": ["slide-header", "slide-body", "slide-footer"],
  "footer": { "visible": true },
  "constraints": { "cardCount": { "min": 3, "max": 5 } },
  "html": "<div class=\"slide-header\"><h1>{{title}}</h1></div><div class=\"slide-body\">{{#cards}}<div class=\"card\"><div class=\"line\"><div class=\"main\"><span class=\"bullet\">▸</span> {{title}}</div><div class=\"sub\">{{subtitle}}</div></div></div>{{/cards}}</div><div class=\"slide-footer\">{{page}} / {{total}}</div>",
  "css": {
    ".slide.content-row": {
      "display": "flex",
      "flex-direction": "column"
    },
    ".slide.content-row .slide-header": {
      "padding-bottom": "20px"
    },
    ".slide.content-row .slide-header h1": {
      "font-size": "var(--slide-title-size)",
      "color": "var(--title)",
      "border-bottom": "3px solid var(--accent)",
      "margin": "0",
      "width": "100%"
    },
    ".slide.content-row .slide-body": {
      "flex": "1",
      "display": "flex",
      "flex-direction": "row",
      "gap": "40px",
      "padding": "20px 0"
    },
    ".slide.content-row .card": {
      "flex": "1",
      "background": "var(--surface)",
      "padding": "var(--slide-card-padding-y) var(--slide-card-padding-x)",
      "border-radius": "var(--slide-card-radius)",
      "display": "flex",
      "flex-direction": "column",
      "justify-content": "center"
    },
    ".slide.content-row .line": {
      "display": "flex",
      "flex-direction": "column",
      "justify-content": "center",
      "align-items": "flex-start",
      "gap": "var(--slide-content-stack-gap)",
      "font-size": "var(--slide-heading-size)",
      "color": "var(--text)"
    },
    ".slide.content-row .line .main": {
      "display": "flex",
      "align-items": "center"
    },
    ".slide.content-row .line .bullet": {
      "color": "var(--accent)",
      "width": "var(--slide-bullet-width)",
      "flex-shrink": "0"
    },
    ".slide.content-row .line .sub": {
      "font-size": "var(--slide-subtitle-size)",
      "color": "var(--muted)",
      "margin-left": "var(--slide-subtitle-indent)",
      "margin-top": "0"
    },
    ".slide.content-row .slide-footer": {
      "padding-top": "20px",
      "font-size": "var(--slide-footer-size)",
      "color": "var(--muted)",
      "text-align": "right"
    }
  }
}
