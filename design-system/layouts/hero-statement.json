{
  "id": "hero-statement",
  "name": "Hero Statement",
  "type": "statement",
  "description": "Large editorial statement slide for a chapter conclusion or key idea.",
  "zones": ["slide-header", "slide-body", "slide-footer"],
  "footer": { "visible": true },
  "html": "<div class=\"hero-wrap\">{{#eyebrow}}<div class=\"hero-eyebrow\">{{eyebrow}}</div>{{/eyebrow}}<h1>{{statement}}</h1>{{#supporting}}<p class=\"hero-supporting\">{{supporting}}</p>{{/supporting}}{{#meta}}<div class=\"hero-meta\">{{meta}}</div>{{/meta}}</div><div class=\"slide-footer\">{{page}} / {{total}}</div>",
  "css": {
    ".slide.hero-statement": { "display": "flex", "flex-direction": "column" },
    ".slide.hero-statement .hero-wrap": { "flex": "1", "display": "flex", "flex-direction": "column", "justify-content": "center", "align-items": "flex-start", "gap": "22px", "max-width": "1540px", "padding-left": "28px", "position": "relative" },
    ".slide.hero-statement .hero-wrap::before": { "content": "\"\"", "position": "absolute", "left": "0", "top": "8px", "bottom": "8px", "width": "4px", "background": "var(--accent)", "border-radius": "999px" },
    ".slide.hero-statement .hero-wrap::after": { "content": "\"\"", "position": "absolute", "inset": "-80px auto auto 240px", "width": "360px", "height": "360px", "border-radius": "999px", "background": "radial-gradient(circle, rgba(88, 166, 255, 0.12), rgba(88, 166, 255, 0.02) 55%, transparent 72%)", "filter": "blur(8px)", "pointer-events": "none" },
    ".slide.hero-statement .hero-eyebrow": { "font-size": "18px", "text-transform": "uppercase", "letter-spacing": "0.24em", "color": "var(--accent)" },
    ".slide.hero-statement h1": { "font-size": "var(--slide-cover-title-size)", "line-height": "1.06", "color": "var(--title)", "font-weight": "bold", "max-width": "1460px", "letter-spacing": "-0.04em" },
    ".slide.hero-statement .hero-supporting": { "font-size": "var(--slide-subtitle-size)", "line-height": "1.55", "color": "var(--muted)", "max-width": "920px" },
    ".slide.hero-statement .hero-meta": { "font-size": "var(--slide-footer-size)", "letter-spacing": "0.14em", "text-transform": "uppercase", "color": "var(--muted)" },
    ".slide.hero-statement .slide-footer": { "padding-top": "20px", "font-size": "var(--slide-footer-size)", "color": "var(--muted)", "text-align": "right" }
  }
}
