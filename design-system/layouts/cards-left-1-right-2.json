{
  "id": "cards-left-1-right-2",
  "name": "左右卡片-左1右2",
  "type": "content",
  "description": "左列1个卡片，右列2个卡片",
  "zones": ["slide-header", "slide-body", "slide-footer"],
  "footer": { "visible": true },
  "structure": { "leftColumn": { "cardCount": 1 }, "rightColumn": { "cardCount": 2 } },
  "html": "<div class=\"slide-header\"><h1>{{title}}</h1></div><div class=\"slide-body\"><div class=\"left\">{{#leftCards}}<div class=\"card\"><div class=\"line\"><div class=\"main\"><span class=\"bullet\">▸</span> {{title}}</div><div class=\"sub\">{{subtitle}}</div></div></div>{{/leftCards}}</div><div class=\"right\">{{#rightCards}}<div class=\"card\"><div class=\"line\"><div class=\"main\"><span class=\"bullet\">▸</span> {{title}}</div><div class=\"sub\">{{subtitle}}</div></div></div>{{/rightCards}}</div></div><div class=\"slide-footer\">{{page}} / {{total}}</div>",
  "css": {
    ".slide.cards": { "display": "flex", "flex-direction": "column" },
    ".slide.cards .slide-header": { "padding-bottom": "20px" },
    ".slide.cards .slide-header h1": { "font-size": "var(--slide-title-size)", "color": "var(--title)", "border-bottom": "3px solid var(--accent)", "margin": "0", "width": "100%" },
    ".slide.cards .slide-body": { "flex": "1", "display": "grid", "grid-template-columns": "1.05fr 1fr", "grid-template-rows": "repeat(2, minmax(0, 1fr))", "gap": "20px" },
    ".slide.cards .left": { "grid-column": "1", "grid-row": "1 / span 2", "display": "flex" },
    ".slide.cards .right": { "grid-column": "2", "grid-row": "1 / span 2", "display": "grid", "grid-template-rows": "repeat(2, minmax(0, 1fr))", "gap": "20px" },
    ".slide.cards .card": { "background": "var(--surface)", "padding": "var(--slide-card-padding-y) var(--slide-card-padding-x)", "border-radius": "var(--slide-card-radius)", "display": "flex", "align-items": "center", "justify-content": "flex-start", "width": "100%", "height": "100%" },
    ".slide.cards .line": { "display": "flex", "flex-direction": "column", "justify-content": "center", "align-items": "flex-start", "gap": "var(--slide-content-stack-gap)", "height": "100%", "font-size": "var(--slide-heading-size)", "color": "var(--text)" },
    ".slide.cards .line .main": { "display": "flex", "align-items": "center" },
    ".slide.cards .line .bullet": { "color": "var(--accent)", "width": "var(--slide-bullet-width)", "flex-shrink": "0" },
    ".slide.cards .line .sub": { "font-size": "var(--slide-subtitle-size)", "color": "var(--muted)", "margin-left": "var(--slide-subtitle-indent)", "margin-top": "0" },
    ".slide.cards .slide-footer": { "padding-top": "20px", "font-size": "var(--slide-footer-size)", "color": "var(--muted)", "text-align": "right" }
  }
}
