{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xa-ppt-skill.local/schemas/presentation-content.schema.json",
  "title": "Presentation Content",
  "type": "object",
  "required": ["version", "slides"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "slide": {
      "type": "object",
      "required": ["layout_id", "theme", "data"],
      "properties": {
        "layout_id": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
